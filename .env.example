# VAJCO — ukázkové environment proměnné.
# Zkopíruj tento soubor do `.env` a doplň skutečné hodnoty.
# Do gitu se `.env` NIKDY necommituje (viz .gitignore).

# --- Databáze -----------------------------------------------------------
# Lokální vývoj (výchozí, funguje bez jakéhokoliv nastavení):
DATABASE_URL="file:./dev.db"

# Produkce / Supabase (Postgres):
# 1. V prisma/schema.prisma přepiš `provider = "sqlite"` na `"postgresql"`
# 2. Sem vlož connection string ze Supabase (Project Settings → Database)
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# --- Admin ---------------------------------------------------------------
# Heslo do administrace rezervací (/admin). Nastav silné heslo.
ADMIN_PASSWORD="zmen-me"
# Náhodný dlouhý řetězec pro podepisování admin session cookie.
# Vygeneruj např.: `openssl rand -base64 32`
ADMIN_SESSION_SECRET="zmen-me-na-nahodny-retezec"

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.vajco.cz"

# --- Kontakty (volitelné — dokud nejsou, web zobrazuje placeholdery) -------
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""

# --- Farma / mapa (volitelné — bez nastavení se použije přibližná poloha
# středu Klentnice) ----------------------------------------------------------
NEXT_PUBLIC_FARM_LAT=""
NEXT_PUBLIC_FARM_LNG=""
# Nastav na "true", jakmile budou souřadnice výše přesná poloha farmy
# (ne jen přibližná poloha obce).
NEXT_PUBLIC_FARM_EXACT="false"
